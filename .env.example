# Supabase PostgreSQL 연결 URL (Transaction Pooler 포트 6543 권장)
# Supabase Dashboard -> Project Settings -> Database -> Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 플랫폼 슈퍼 관리자 키 (새 예매 사이트 등록 및 API Key 발급용 - 충분히 긴 랜덤 문자열 사용)
PLATFORM_MASTER_KEY=change-me-to-a-long-random-secret

# 서버 포트
PORT=3000
NODE_ENV=development
